<section
    id="contact"
    class="min-h-screen bg-arctic-lab bg-[length:400%_400%] animate-bgShift [perspective:2000px] flex flex-col items-center justify-center text-center px-6 relative overflow-hidden"
>
    <div class="absolute inset-0 pointer-events-none z-10">
        <div class="glass-cube lg:hidden c1-mobile absolute"></div>
        <div class="glass-cube lg:hidden c2-mobile absolute"></div>
        <div class="glass-cube lg:hidden c3-mobile absolute"></div>
        <div class="glass-cube lg:hidden c4-mobile absolute"></div>
        <div class="glass-cube lg:hidden c5-mobile absolute"></div>
        <div class="glass-cube lg:hidden c6-mobile absolute"></div>
        <div class="glass-cube lg:hidden c7-mobile absolute"></div>

        <div class="glass-cube hidden lg:block c1 absolute"></div>
        <div class="glass-cube hidden lg:block c2 absolute"></div>
        <div class="glass-cube hidden lg:block c3 absolute"></div>
        <div class="glass-cube hidden lg:block c4 absolute"></div>
        <div class="glass-cube hidden lg:block c5 absolute"></div>
        <div class="glass-cube hidden lg:block c6 absolute"></div>
        <div class="glass-cube hidden lg:block c7 absolute"></div>
