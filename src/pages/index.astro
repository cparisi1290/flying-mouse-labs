---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Web Design & Data Science Agency for Small to Medium Businesses">
    <Navbar />

    <!-- HERO SECTION -->
    <section id="home"
        class="flex flex-col min-h-screen w-full relative overflow-hidden bg-arctic-lab bg-[length:400%_400%] animate-bgShift [perspective:2000px]">
        <div
            class="flex-1 flex flex-col items-center md:items-start justify-center pt-20 md:pt-28 lg:pt-42 px-6 md:px-12 lg:px-48 text-left relative z-20">
            <div class="absolute inset-0 pointer-events-none z-10">
                <!-- Mobile Cubes -->
                <div class="glass-cube c1-mobile absolute lg:hidden"></div>
                <div class="glass-cube c2-mobile absolute lg:hidden"></div>
                <div class="glass-cube c3-mobile absolute lg:hidden"></div>
                <div class="glass-cube c4-mobile absolute lg:hidden"></div>
                <div class="glass-cube c5-mobile absolute lg:hidden"></div>
                <div class="glass-cube c6-mobile absolute lg:hidden"></div>
                <div class="glass-cube c7-mobile absolute lg:hidden"></div>

                <!-- Desktop Cubes -->
                <div class="glass-cube c1 absolute lg:block hidden"></div>
                <div class="glass-cube c2 absolute lg:block hidden"></div>
                <div class="glass-cube c3 absolute lg:block hidden"></div>
                <div class="glass-cube c4 absolute lg:block hidden"></div>
                <div class="glass-cube c5 absolute lg:block hidden"></div>
                <div class="glass-cube c6 absolute lg:block hidden"></div>
                <div class="glass-cube c7 absolute lg:block hidden"></div>
            </div>

            <div class="lg:max-w-4xl w-full flex flex-col items-center lg:items-start space-y-8">
                <h1 class="text-[10px] font-white opacity-0">
                    Web design and data science agency for small to medium
                    businesses
                </h1>
                <h2
                    class="text-balance text-4xl md:text-7xl lg:text-8xl font-black text-slate-950 leading-tight uppercase relative z-30 text-center lg:text-left">
                    Make Your<br class="lg:hidden" />
                    First Impression<br class="lg:hidden" />
                    <span class="text-amber-500 text-[42px] md:text-[84px] lg:text-8xl">Unforgettable</span>
                </h2>

                <p
                    class="text-lg md:text-2xl lg:text-3xl text-slate-950 max-w-3xl font-medium text-center lg:text-left relative z-30">
                    Creating custom designs that captivate, convert, and
                    <span class="italic font-bold">linger</span>. Because
                    blending in has never been your style.
                </p>

                <div
                    class="flex flex-col md:flex-row md:justify-center lg:justify-start gap-4 w-full md:max-w-2xl max-w-xs pt-4 relative z-30">
                    <a href="#contact"
                        class="w-full md:w-72 py-3 md:py-4 bg-slate-950 text-white rounded-full font-bold tracking-widest uppercase transition-transform hover:scale-105 active:scale-95 shadow-lg text-center no-underline">
                        Launch Your Project
                    </a>

                    <a href="#projects"
                        class="w-full md:w-64 py-3 md:py-4 rounded-full border-2 border-slate-950 text-slate-950 font-bold tracking-widest uppercase transition-all hover:scale-105 active:scale-95 shadow-lg text-center no-underline"
                        style="
                                background: rgba(255, 255, 255, 0.4);
                                backdrop-filter: blur(10px);
                            ">
                        Explore Lab
                    </a>
                </div>
            </div>
        </div>
    </section>

    <script is:inline>
    window.servicesData = [
        {id: 1, title: 'Design', tags: ['Branding', 'Messaging', 'Graphics', 'Copywriting'], img: 'design-balloons.webp', desc: 'Custom, intuitive designs that capture your brand\'s unique strength and individuality. Every detail draws visitors in and keeps them engaged.', imageAlt: 'Custom web design solutions created around your business goals'},
        {id: 2, title: 'Build', tags: ['Web Development', 'UI/UX', 'Strategy', 'Mobile App Development'], img: 'build-community.webp', desc: 'We engineer fast, reliable, and secure websites built to convert and optimized to perform across every device.', imageAlt: 'A dedicated agency team working with small to medium business owners'},
        {id: 3, title: 'Scale', tags: ['Data Automations', 'Data Analytics', 'Data Science', 'LLM Chatbot'], img: 'scale-bubbles.webp', desc: 'We build intelligent systems that automate workflows, enhance decision-making, and unlock new levels of efficiency.', imageAlt: 'Turning complex data into clear, beautiful web experiences'}
    ];
</script>
<!-- SERVICES SECTION -->
    <section id="services" x-data="{
        activeService: 1,
        services: window.servicesData
    }" class="py-20 lg:py-36 px-6 md:px-12 bg-white">
        <div class="text-center mb-12 lg:mb-20">
            <h2 class="text-balance text-5xl md:text-6xl lg:text-7xl font-black text-slate-950 leading-tight uppercase">
                Services to <br class="md:hidden lg:hidden" />help
                <br class="hidden md:block lg:hidden" />you
                <br class="md:hidden lg:hidden" />
                <span class="text-sky-600 italic uppercase">soar</span>
            </h2>
        </div>

        <div
            class="max-w-4xl lg:max-w-7xl mx-auto space-y-6 lg:space-y-0 lg:flex lg:flex-row lg:items-stretch lg:gap-4 lg:h-[600px]">
            <template x-for="(service, index) in services" :key="index" >
                <div @click="activeService = service.id"
                    @mouseenter="window.innerWidth >= 1024 ? activeService = service.id : null"
                    class="group relative overflow-hidden rounded-3xl transition-all duration-700 cursor-pointer shadow-xl"
                    :class="activeService === service.id ? 'h-[400px] md:h-[500px] lg:h-[600px] lg:flex-[3]' : 'h-[100px] lg:h-full lg:flex-1'">
                    <img :src="'/images/' + service.img" width="800" height="600"
                        class="absolute inset-0 w-full h-full object-cover transition-all duration-700" :class="activeService !== service.id
                                 ? 'grayscale brightness-100 opacity-80 blur-sm scale-110'
                                 : 'grayscale-0 brightness-100 opacity-100 blur-0 scale-100 group-hover:scale-105'"
                        :alt="service.imageAlt" :loading="service.id === 1 ? 'eager' : 'lazy'" />

                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/80 via-black/60 via-black/40 md:from-black md:via-black/65 md:via-black/30 md:to-transparent transition-opacity duration-500"
                        :class="activeService === service.id ? 'opacity-100' : 'opacity-0'"></div>

                    <div x-show="activeService === service.id"
                        x-transition:enter="transition opacity ease-out duration-500 delay-200"
                        x-transition:enter-start="opacity-0 translate-y-4"
                        x-transition:enter-end="opacity-100 translate-y-0"
                        class="absolute inset-0 p-8 md:p-12 flex flex-col justify-end">
                        <span x-show="activeService === service.id"
                            class="text-[#ffffff] text-lg md:text-xl font-bold mb-2" x-text="'0' + service.id"></span>

                        <h3 x-show="activeService === service.id"
                            class="text-balance text-[#ffffff] text-5xl md:text-7xl font-black uppercase mb-4 tracking-tighter"
                            x-text="service.title"></h3>

                        <div x-show="activeService === service.id" x-collapse>
                            <p class="text-[#ffffff] text-lg md:text-xl mb-8 leading-relaxed max-w-2xl"
                                x-text="service.desc"></p>

                            <div class="flex flex-wrap gap-2 md:gap-3">
                                <template x-for="tag in service.tags" :key="tag">
                                    <span
                                        class="px-4 py-2 border border-white/60 rounded-full text-white text-[10px] md:text-xs uppercase font-black tracking-widest bg-white/10 backdrop-blur-md"
                                        x-text="tag"></span>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </section>

    <!-- CASE STUDIES SECTION-->
    <section id="case-studies" x-data="{
                    shown: false,
                    metrics: [

                        { label: 'Conversion', value: 350, prefix: '+', suffix: '%', desc: 'Higher conversion rates from professional UX/UI design.', source: 'Forrester Research' },

                        { label: 'ROI', value: 100, prefix: '$', suffix: '', desc: 'Return for every $1 invested in UX/design.', source: 'Forrester Research' },

                        { label: 'Engagement', value: 85, prefix: '', suffix: '%', desc: 'Increase in engagement through visual storytelling.', source: 'Interaction Design Foundation / Forrester-linked studies' },

                        { label: 'Revenue Growth', value: 120, prefix: '+', suffix: '%', desc: 'YoY revenue increase from professional website redesigns.', source: 'Industry redesign case studies & UX reports' }
                    ],

                    init() {
                        const observer = new IntersectionObserver((entries) => {
                            if (entries[0].isIntersecting) {
                                this.shown = true;
                                observer.unobserve(this.$el);
                            }
                        }, { threshold: 0.3 });
                        observer.observe(this.$el);
                    }

                }"
        class="py-20 px-6 md:px-12 bg-arctic-lab animate-bgShift bg-[length:400%_400%] min-h-screen flex flex-col justify-center [perspective:2000px]">
        <div class="text-center mb-24">
            <h2
                class="text-balance text-4xl md:text-6xl lg:text-7xl font-black text-slate-950 leading-tight uppercase tracking-tighter">
                Proven Results.<br />
                <span class="text-sky-600 uppercase">Measurable Impact.</span>
            </h2>
        </div>

        <div
            class="max-w-md md:max-w-4xl lg:max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 w-full px-2">
            <template x-for="item in metrics" :key="item.label">
                <div
                    class="bg-white/60 backdrop-blur-md rounded-[32px] p-6 md:p-10 border border-white/40 shadow-sm flex flex-col justify-between h-auto min-h-[220px] md:min-h-[280px] lg:min-h-[320px] transition-all duration-500 hover:scale-[1.02] hover:bg-white/80">
                    <div>
                        <p class="text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase text-slate-950 opacity-60 mb-6"
                            x-text="item.label"></p>
                        <h3
                            class="text-balance text-5xl md:text-6xl font-black text-slate-950 tracking-tighter flex items-baseline mb-4">
                            <span class="mr-[-2px]" x-text="item.prefix"></span>
                            <span x-data="counterLogic(item.value)"
                                x-init="$watch('shown', value => { if(value) start(); })" x-text="display"></span>
                            <span class="ml-[-2px]" x-text="item.suffix"></span>
                        </h3>
                        <p class="text-lg md:text-xl font-semibold text-slate-950/80 leading-tight md:leading-snug md:max-w-full"
                            x-text="item.desc"></p>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-950/5 font-mono tracking-wider">
                        <p class="text-[9px] font-bold text-slate-950/40 uppercase leading-none" x-text="item.source">
                        </p>
                    </div>
                </div>
            </template>
        </div>
    </section>


    <script>
        function counterLogic(target) {
            return {
                display: 0,
                start() {
                    let startTime = null;
                    const duration = 1500;
                    const step = (timestamp) => {
                        if (!startTime) startTime = timestamp;
                        const progress = Math.min(
                            (timestamp - startTime) / duration,
                            1,
                        );
                        const current = progress * target;
                        this.display =
                            target % 1 === 0
                                ? Math.floor(current)
                                : current.toFixed(1);
                        if (progress < 1) requestAnimationFrame(step);
                    };
                    requestAnimationFrame(step);
                },
            };
        }
    </script>

    
    <script is:inline>
        window.projectsData = {
          activeProject: null,
          currentIndex: 0,
          activeMobileDot: 0,
          projects: [
            {
              coverWebm: "/images/nhc-port-cover.webm",
              title: "Nova Health Collective",
              category: "Branding + Web Design",
              description: "Mason came to [us] ready to level up her brand and expand her offerings from midwifery to include psychedelic facilitation. She needed a brand that felt aligned with her vision so we left behind a partner-chosen logo and created something entirely new. The result: a grounded, modern and strategic brand identity and a custom 5-page website with a client portal for resources and an events page to support her growing practice. Now, Mason's online presence feels as expansive and intentional as her work.",
              quote: "I really like [the logo]! I love it, this looks really wonderful and I don't have any revisions to the website to request.",
              before: "",
              after: "/images/nhc-after.webp",
              coverAlt: "Nova Health Collective website redesign",
              beforeAlt: "",
              afterAlt: "Modern and strategic brand identity and custom website for a midwifery and psychedelic facilitation practice",
            },
            {
              coverWebm: "/images/kvs-port-cover.webm",
              title: "Kay's Virtual Solutions",
              category: "Website Design",
              description: "Kayla came to us knowing her old website just wasn't cutting it. She wanted something that actually reflected her vibe of being polished, feminine and ready to attract her dream clients. Using her existing logo, colors, and fonts, we built a site that felt like her and resonated with the people she wanted to work with. As her business evolved into business efficiency consulting, we updated her site with the same brand but with fresh brand photos and a custom AI-scripted chatbot.",
              quote: "I always fall in love with Cassandra's designs.She consistently delivers on professionalism and impact.Seriously, I'm always impressed with Cassandra and her design abilities. She's my go to girl for web design",
              before: "/images/kvs-before.webp",
              after: "/images/kvs-after.webp",
              coverAlt: "Kay's Virtual Solutions website redesign",
              beforeAlt: "Kay's Virtual Solutions original website",
              afterAlt: "Polished and feminine website redesign for a fractional COO business consulting firm",
            },
            {
              coverWebm: "/images/luxe-port-cover.webm",
              title: "Luxe Pet Parlor",
              category: "Branding + Web Design",
              description: "Cheyanne came to us needing a rebrand from loud and disheveled to calming and luxurious. Inspired by her Cajun roots and spa-like vision, we created a soothing visual identity using pastel greens, soft purples, and natural wood tones.",
              quote: "The thing I liked most about working with Cass was how easy she made everything.",
              before: "",
              after: "/images/luxe-after.webp",
              coverAlt: "Luxe Pet Parlor brand and website design",
              beforeAlt: "",
              afterAlt: "Calming and luxurious brand identity and website for a pet grooming business",
            },
            {
              coverWebm: "/images/colliance-port-cover.webm",
              title: "Colliance Online Business Management",
              category: "Website Redesign",
              description: "After their original designer ghosted them, Sandy needed someone to step in and bring her vision to life. Using the existing branding, we rebuilt her website to feel brighter, more inviting, and easy to navigate. I expanded the site to include individual service pages, team intros, and tiered offerings specific to different business stages. We also designed two strategic sales funnels for their project management and bookkeeping services. The result is a warm, well-structured site that truly reflects their professionalism and builds trust with potential clients.",
              quote: "[Flying Mouse Labs] is always on top of any task we give [them] and does incredible design work.",
              before: "/images/colliance-before.webp",
              after: "/images/colliance-after.webp",
              coverAlt: "Colliance Online Business Management website redesign",
              beforeAlt: "",
              afterAlt: "Brighter, more inviting, and easy to navigate website redesign for a business management consulting firm",
            },
            {
              coverWebm: "/images/das-port-cover.webm",
              title: "Damaris Accounting",
              category: "Web Design",
              description: "Damaris, an accountant offering bookkeeping, tax prep, business formation, and accounting services, needed a site that matched the quality of her work. Her original site fell short, so we rebuilt it on Squarespace using her existing logo and elevated the branding to feel modern, professional, and luxurious. The new single-page site clearly presents her services, with on-page SEO and Google tools in place to support future growth. Damaris said I brought her vision to life and that she didn't know her site could look this good.",
              quote: "I had a website that was done for free, but it wasn't finished, and it definitely didn't reflect the quality of my business. I knew I needed something more professional, but I wasn't sure who to trust with the redesign. I was concerned about finding someone who could understand my business and make the process feel manageable. [Flying Mouse Labs] made it incredibly easy. From strategy to Google Business Profile to the design itself, she brought everything together beautifully. My new website is even better than I imagined it could be!",
              before: "",
              after: "/images/das-after.webp",
              coverAlt: "Damaris Accounting website redesign",
              beforeAlt: "",
              afterAlt: "Professional website redesign for an accounting firm",
            },
            {
              coverWebm: "/images/gg-port-cover.webm",
              title: "Grateful Graze",
              category: "Branding + Web Design",
              description: "Ericka's business was in between the stage of start up and brick and mortar. One of her problems was that her current website that could not take online orders, folks could only call in their order. This we found was a fundamental point in her journey. After implementing an online orderer to her site, she's since opened a store front as the first charcuterie and cheese grazing cafe in WIlington. NC.",
              quote: "We have worked together remotely and to say it's been a breeze during the whole website design would be an understatement! Cassandra is so great to work with, she created exactly what I had envisioned and I couldn't be happier with how the new website turned out. If you need any design or website development done for your business please reach out to Cassandra, you won't be disappointed!",
              before: "",
              after: "/images/gg-after.webp",
              coverAlt: "Grateful Graze website redesign",
              beforeAlt: "",
              afterAlt: "Eclectic website redesign for a charcuterie and cheese grazing cafe",
            },
          ],
          get mobileProjects() {
            return [...this.projects, ...this.projects];
          },
          handleInfiniteScroll() {
            const el = this.$refs.mobileScroll;
            const halfway = el.scrollWidth / 2;
            if (el.scrollLeft >= halfway) {
              el.scrollLeft -= halfway;
            }
            if (el.scrollLeft <= 0) {
              el.scrollLeft += halfway;
            }
            const cardWidth = el.scrollWidth / (this.projects.length * 2);
            this.activeMobileDot =
              Math.round(el.scrollLeft / cardWidth) % this.projects.length;
          },
          openProject(index) {
            this.currentIndex = index;
            this.activeProject = this.projects[index];
            document.body.style.overflow = "hidden";
            window.dispatchEvent(
              new CustomEvent("modal-state", { detail: { open: true } }),
            );
          },
          closeProject() {
            this.activeProject = null;
            document.body.style.overflow = "auto";
            window.dispatchEvent(
              new CustomEvent("modal-state", { detail: { open: false } }),
            );
          },
          prev() {
            this.currentIndex =
              this.currentIndex > 0 ? this.currentIndex - 1 : this.projects.length - 1;
            this.activeProject = this.projects[this.currentIndex];
          },
          next() {
            this.currentIndex =
              this.currentIndex < this.projects.length - 1 ? this.currentIndex + 1 : 0;
            this.activeProject = this.projects[this.currentIndex];
          },
        };
    </script>
<!-- PROJECTS SECTION -->
    <section id="projects" x-data="window.projectsData"
        class="py-32 md:min-h-screen bg-white overflow-x-hidden relative">
        <!-- PROJECTS MOBILE + TABLET -->
        <div class="lg:hidden px-6 md:px-12 mb-12 lg:mb-20">
            <h2
                class="text-balance text-5xl md:text-6xl font-black text-slate-950 tracking-tighter uppercase leading-none">
                Projects.
            </h2>
            <div class="h-1 w-12 bg-sky-500 mt-4 rounded-full"></div>
        </div>

        <div class="lg:hidden flex overflow-x-auto no-scrollbar gap-4 px-6 md:px-12 pb-10" x-ref="mobileScroll"
            @scroll="handleInfiniteScroll()" x-init="$nextTick(() => {
                    const el = $refs.mobileScroll;
                    el.addEventListener('scroll', () => handleInfiniteScroll(), { passive: true });
                })">
            <template x-for="(project, index) in mobileProjects" :key="'mobile-'+index">
                <div @click="openProject(index % projects.length)"
                    class="shrink-0 w-[85vw] md:w-[45vw] max-w-[400px] aspect-[3/4] rounded-[40px] overflow-hidden cursor-pointer bg-gray-100">
                    <video autoplay loop muted playsinline class="w-full h-full object-cover">
                        <source :src="project.cover" type="video/mp4">
                        <source :src="project.coverWebm" type="video/webm">
                    </video>
                </div>
            </template>
        </div>

        <!-- Dots -->
        <div class="lg:hidden flex justify-center gap-2 mt-4 mb-8">
            <template x-for="(project, index) in projects" :key="'pdot-'+index">
                <div class="h-1.5 rounded-full transition-all duration-300 bg-slate-950"
                    :class="activeMobileDot === index ? 'w-6 opacity-100' : 'w-1.5 opacity-20'"></div>
            </template>
        </div>

        <!-- PROJECTS DESKTOP -->
        <div
            class="lg:block hidden projects-bg-text absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-3/4 z-0 opacity-30 pointer-events-none select-none uppercase">
            Projects
        </div>

        <div class="hidden lg:flex flex-col items-center justify-center min-h-[700px] relative mt-[12vw]">
            <div class="w-full perspective-2500 flex items-center justify-center">
                <div class="carousel-stage relative w-[300px] h-[450px] preserve-3d">
                    <template x-for="(project, index) in projects" :key="'desktop-'+index">
                        <div @click="openProject(index)"
                            class="carousel-card absolute inset-0 rounded-[40px] overflow-hidden cursor-pointer shadow-xl transition-all duration-500 group"
                            :style="`--index: ${index}; --total: ${projects.length};`">

                            <video autoplay loop muted playsinline class="w-full h-full object-cover">
                                <source :src="project.coverWebm" type="video/webm">
                                <source :src="project.cover" type="video/mp4">
                            </video>

                            <div
                                class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-8">
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <template x-teleport="body">
            <div x-show="activeProject" x-cloak
                class="fixed inset-0 z-[200] flex items-center justify-center bg-slate-950/30 backdrop-blur-md p-4 md:p-8">
                <div @click="closeProject()" class="absolute inset-0"></div>

                <div x-show="activeProject" x-transition:enter="transition ease-out duration-500"
                    x-transition:enter-start="opacity-0 translate-y-20 scale-95"
                    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                    class="bg-white w-full max-w-4xl h-[90vh] rounded-[40px] shadow-2xl relative z-10 flex flex-col overflow-hidden">
                    <div class="px-8 pt-24 pb-6 text-center relative border-b border-gray-50">
                        <button @click="closeProject()"
                            class="absolute top-6 right-8 text-gray-400 hover:text-slate-950 transition-colors"
                            aria-label="Close projects" aria-label="Close projects">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>

                        <h3 class="text-balancetext-3xl md:text-4xl font-black text-slate-950 leading-tight uppercase tracking-tighter mb-2"
                            x-text="activeProject?.title"></h3>
                        <p class="text-sky-500 text-[10px] font-black uppercase tracking-[0.2em]">
                            // Category:
                            <span x-text="activeProject?.category" class="text-gray-400"></span>
                        </p>
                    </div>

                    <div class="flex-grow overflow-y-auto px-8 md:px-12 py-8 space-y-10 no-scrollbar">
                        <p class="text-gray-600 text-base font-medium leading-relaxed"
                            x-text="activeProject?.description"></p>

                        <div class="border-l-4 border-amber-500 pl-6 py-2 italic text-gray-500 text-lg">
                            <p x-text="activeProject?.quote"></p>
                        </div>

                        <div :class="activeProject?.before ? 'grid grid-cols-2 gap-4' : 'w-full'">
                            <template x-if="activeProject?.before">
                                <div class="space-y-3">
                                    <div class="rounded-3xl overflow-hidden shadow-sm border border-gray-100">
                                        <img :src="activeProject?.before" width="600" height="400"
                                            class="w-full h-auto object-cover" :alt="activeProject?.beforeAlt"
                                            loading="lazy"
                                            @error="$el.src='https://placehold.co/600x400?text=Image+Not+Found'" />
                                    </div>
                                </div>
                            </template>

                            <div class="space-y-3">
                                <div class="rounded-3xl overflow-hidden shadow-xl ring-1 ring-gray-100">
                                    <img :src="activeProject?.after" width="600" height="400"
                                        class="w-full h-auto object-cover" :alt="activeProject?.afterAlt" loading="lazy"
                                        @error="$el.src='https://placehold.co/600x400?text=Image+Not+Found'" />
                                </div>
                            </div>
                        </div>

                        <div class="h-10"></div>
                    </div>

                    <div
