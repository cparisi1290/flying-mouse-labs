---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Blog Post | Flying Mouse Labs">
    <Navbar />
    
    <!-- Google Tag Manager (noscript) -->
    <noscript
        ><iframe
            src="https://www.googletagmanager.com/ns.html?id=GTM-KG2P58FL"
            height="0"
            width="0"
            style="display: none; visibility: hidden"
        ></iframe
    ></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <main
        x-data="{
            activeSection: 'intro',
            readingTime: 0,
            calculateReadingTime() {
                const text = this.$refs.content.innerText;
                const wordsPerMinute = 200;
                this.readingTime = Math.ceil(text.split(/\s+/).length / wordsPerMinute);
            }
        }"
        x-init="calculateReadingTime()"
        class="relative mt-12 md:mt-24 mb-24 px-6 max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-[250px_1fr_350px] gap-12 lg:gap-20"
    >
        <aside class="hidden lg:block">
            <div
                class="sticky top-32 p-8 bg-white/40 backdrop-blur-md border border-white/40 rounded-[32px] shadow-xl"
            >
                <span
                    class="font-mono text-[10px] font-bold tracking-[0.2em] text-sky-600 uppercase mb-6 block"
                >
                    // DATA_INDEX
                </span>
                <nav class="flex flex-col gap-4">
                    <template
                        x-for="link in [
                            { id: 'intro', label: '01. Initializing Deployment' },
                            { id: 'performance', label: '02. Arctic Load Specs' },
                            { id: 'optimization', label: '03. Final Optimization' }
                        ]"
                    >
                        <a
                            :href="'#' + link.id"
                            @click="activeSection = link.id"
                            class="font-mono text-xs transition-all duration-300 border-l-2 pl-4 py-1"
                            :class="activeSection === link.id ? 'border-sky-600 text-slate-950 font-bold' : 'border-transparent text-slate-950/40 hover:text-slate-950'"
                            x-text="link.label"
                        >
                        </a>
                    </template>
                </nav>
            </div>
        </aside>

        <article class="overflow-hidden" ref="content">
            <nav
                class="flex mb-8 text-[10px] font-bold uppercase tracking-[0.2em] text-[#041A24]/40"
                aria-label="Breadcrumb"
            >
                <ol class="flex items-center space-x-2">
                    <li>
                        <a
                            href="/"
                            class="hover:text-sky-600 transition-colors"
                            >Home</a
                        >
                    </li>
                    <li class="flex items-center gap-2">
                        <span>/</span>
                        <a
                            href="/blog"
                            class="hover:text-sky-600 transition-colors"
                            >Blog</a
                        >
                    </li>
                    <li class="flex items-center gap-2 text-sky-600/60">
                        <span>/</span>
                        <span class="truncate max-w-[150px]"
                            >Current Intelligence</span
                        >
                    </li>
                </ol>
            </nav>
            <header class="mb-12">
                <h1
                    class="font-heading font-bold text-4xl md:text-6xl text-slate-950 mt-4 mb-6 leading-[1.1] uppercase tracking-tighter"
                >
                    The Arctic Logic of
                    <span class="text-sky-600">High-Performance</span>
                    Systems
                </h1>
                <div
                    class="flex flex-row items-center justify-between gap-4 mb-6"
                >
                    <span
                        class="font-mono text-xs font-bold tracking-[0.2em] text-sky-600 uppercase"
                    >
                        // PUBLISHED JAN 09 2026
                    </span>

                    <div
                        class="inline-flex items-center gap-3 px-4 py-2 bg-sky-200 text-slate-950 font-mono text-[10px] rounded-lg"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 512 512"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="32"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-sky-600"
                        >
                            <circle cx="256" cy="256" r="208" />
                            <polyline points="256 128 256 256 320 320" />
                        </svg>
                        <span
                            >EST_TIME:
                            <span x-text="readingTime"></span> MIN</span
                        >
                    </div>
                </div>
            </header>

            <div
                class="prose prose-lg max-w-none text-slate-950/80 leading-relaxed space-y-8"
            >
                <section id="intro" class="scroll-mt-32">
                    <p
                        class="text-xl md:text-2xl font-medium text-slate-950 leading-snug italic"
                    >
                        In the digital landscape of 2026, speed is no longer
                        a luxury—it is the baseline.
                    </p>
                </section>

                <section id="performance" class="scroll-mt-32">
                    <h2
                        class="font-heading text-3xl md:text-4xl text-slate-950 pt-8 mb-6 uppercase tracking-tight"
                    >
                        Arctic Load Specs
                    </h2>
                    <p>
                        Scaling a digital engine requires more than just raw
                        power. It requires a cooled, calculated approach to
                        asset management. Every byte must serve a purpose.
                    </p>

                    <div
                        class="my-12 rounded-[40px] overflow-hidden bg-white/40 border border-white/40 aspect-video shadow-2xl relative group"
                    >
                        <img
                            src="https://picsum.photos/seed/arctic/1200/800"
                            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                            alt="Tech Visual"
                        />
                        <div
                            class="absolute bottom-6 left-6 bg-slate-950 text-white px-4 py-2 rounded-xl text-xs font-mono opacity-0 group-hover:opacity-100 transition-opacity"
                        >
                            IMG_REF: ARCTIC_SURFACE_01
                        </div>
                    </div>
                </section>

                <section id="optimization" class="scroll-mt-32">
                    <h2
                        class="font-heading text-3xl md:text-4xl text-slate-950 pt-8 mb-6 uppercase tracking-tight"
                    >
                        Final Optimization
                    </h2>
                    <p>
                        Vestibulum mattis ut turpis et hendrerit. Vivamus
                        quis tincidunt quam. Integer id volutpat risus.
                        Praesent placerat, risus eu rutrum fringilla.
                    </p>
                </section>
            </div>

            <footer
                class="mt-20 pt-10 border-t border-slate-950/10 flex flex-wrap items-center gap-6"
            >
                <span
                    class="font-mono text-xs font-bold tracking-widest text-slate-950/40 uppercase"
                    >SHARE_FILE:</span
                >
                <div class="flex gap-4">
                    <a
                        href="https://www.linkedin.com/in/cassandra-parisi/"
                        target="_blank"
                        class="text-slate-950 hover:text-sky-600 transition-transform hover:scale-105"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                            />
                        </svg>
                    </a>
                </div>
            </footer>
        </article>

        <aside class="flex flex-col gap-10">
            <div
                class="p-8 bg-white/40 backdrop-blur-md border border-white/40 rounded-[40px] shadow-xl"
            >
                <img
                    src="https://i.pravatar.cc/150?u=boldarctic"
                    alt="Author"
                    class="w-20 h-20 rounded-2xl mb-6 shadow-lg rotate-3 border-2 border-white"
                />
                <h4
                    class="font-heading text-xl text-slate-950 uppercase tracking-tight"
                >
                    Erik Sterling
                </h4>
                <p class="text-sm text-slate-950/60 mt-4 leading-relaxed">
                    Lead Architect at Flying Mouse Labs. Specializing in
                    high-frequency scaling and glassmorphism.
                </p>
            </div>

            <div
                class="p-8 bg-slate-950 text-white rounded-[40px] shadow-2xl"
            >
                <span
                    class="font-mono text-[10px] tracking-[0.2em] text-sky-600 uppercase block mb-8 border-b border-white/10 pb-4"
                >
                    RELATED_LOGS
                </span>
                <div class="space-y-8">
                    <a href="#" class="group block">
                        <h5
                            class="font-bold text-lg leading-tight group-hover:text-sky-600 transition-colors"
                        >
                            The Future of Minimalist Interfaces
                        </h5>
                        <p
                            class="font-mono text-[9px] text-white/40 mt-3 tracking-widest uppercase italic"
                        >
                            5 MIN READ &rarr;
                        </p>
                    </a>
                    <a href="#" class="group block">
                        <h5
                            class="font-bold text-lg leading-tight group-hover:text-sky-600 transition-colors"
                        >
                            Security Protocols for 2026
                        </h5>
                        <p
                            class="font-mono text-[9px] text-white/40 mt-3 tracking-widest uppercase italic"
                        >
                            8 MIN READ &rarr;
                        </p>
                    </a>
                </div>
            </div>
        </aside>
    </main>

    <Footer />
</Layout>
