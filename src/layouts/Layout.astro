---
interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
}

const {
	title,
	description = "Helping small to medium businesses grow with custom web design, data dashboards, and AI and result-driven solutions. Let's build something extraordinary.",
	image = "https://flyingmouselabs.com/images/og-social-sharing.jpg",
	canonical = "https://flyingmouselabs.com/"
} = Astro.props;

const siteName = "Flying Mouse Labs";
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/images/fml-logo-favicon.png" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />

        <link rel="canonical" href={canonical} />

        <!-- Open Graph / Twitter Social Sharing -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />

        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonical} />
        <meta property="twitter:title" content={fullTitle} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={image} />

        <meta name="theme-color" content="#041A24" />

        <!-- Styles -->
        <link rel="stylesheet" href="/src/style.css" />

        <!-- Termageddon CDN -->
        <link rel="preconnect" href="https://termageddon.arm3.cdn.digitaloceanspaces.com" crossorigin>

        <!-- Google Tag Manager -->
        <script>
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    "gtm.start": new Date().getTime(),
                    event: "gtm.js",
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != "dataLayer" ? "&l=" + l : "";
                j.async = true;
                j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", "GTM-KG2P58FL");
        </script>
        <!-- End Google Tag Manager -->

        <!-- Google Search Console -->
        <meta name="google-site-verification" content="7OWUtUXtqeqJ-ennJP6lumMwxyab2CrSv_ZjsBHQVwk" />

        <!-- Microsoft Clarity -->
        <script type="text/javascript">
            (function (c, l, a, r, i, t, y) {
                c[a] =
                    c[a] ||
                    function () {
                        (c[a].q = c[a].q || []).push(arguments);
                    };
                t = l.createElement(r);
                t.async = 1;
                t.src = "https://www.clarity.ms/tag/" + i;
                y = l.getElementsByTagName(r)[0];
                y.parentNode.insertBefore(t, y);
            })(window, document, "clarity", "script", "vwte2khcda");
        </script>

        <!-- GBP & Organization Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "ProfessionalService",
                "name": "Flying Mouse Labs",
                "url": "https://flyingmouselabs.com/",
                "logo": "https://flyingmouselabs.com/images/fml-logo-v2.svg",
                "image": "https://flyingmouselabs.com/images/og-social-sharing.jpg",
                "description": "Helping small to medium businesses grow with custom web design, data dashboards, and AI and result-driven solutions. Let's build something extraordinary.",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Sarasota",
                    "addressRegion": "FL",
                    "addressCountry": "US"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "latitude": 27.3364,
                    "longitude": -82.5307
                },
                "areaServed": [
                    {
                        "@type": "Country",
                        "name": "United States"
                    },
                    {
                        "@type": "AdministrativeArea",
                        "name": "Tampa Bay Area"
                    },
                    {
                        "@type": "City",
                        "name": "Sarasota"
                    }
                ],
                "sameAs": [
                    "https://www.linkedin.com/company/flying-mouse-labs",
                    "https://www.instagram.com/flyingmouselabs",
                    "https://www.youtube.com/@flyingmouselabs",
                    "https://www.facebook.com/flyingmouselabs",
                    "https://www.tiktok.com/@flying.mouse.labs"
                ],
                "aggregateRating": {
                    "@type": "AggregateRating",
                    "ratingValue": "5",
                    "reviewCount": "25"
                }
            })}>
        </script>

        <script is:inline defer src="https://unpkg.com/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    </head>

    <body class="bg-white">
        <!-- Google Tag Manager (noscript) -->
        <noscript
            ><iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-KG2P58FL"
                height="0"
                width="0"
                style="display: none; visibility: hidden"
            ></iframe
        ></noscript>
        <!-- End Google Tag Manager (noscript) -->

        <slot />
    </body>
</html>
